{
  "name": "omp-channel",
  "version": "0.1.0",
  "description": "Oh My Pi extension that delivers messages from an external console into an agent session and sends replies back.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "docs/protocol.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "omp:e2e": "node test/omp-e2e/run.mjs",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "extension",
    "coding-agent",
    "agent",
    "channel",
    "mcp",
    "messaging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommasomarchionni/omp-channel.git"
  },
  "bugs": {
    "url": "https://github.com/tommasomarchionni/omp-channel/issues"
  },
  "homepage": "https://github.com/tommasomarchionni/omp-channel#readme",
  "author": "Tommaso Marchionni",
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@oh-my-pi/pi-coding-agent": "19.2.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
